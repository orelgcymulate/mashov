# ---------------------------------------------------------------------------
# Mashov Dashboard configuration
# ---------------------------------------------------------------------------
# Copy this file to `.env` and fill in real values. Never commit `.env`.
#
# Find your school's `semel` (numeric school ID) here:
#   https://web.mashov.info/api/schools
#
# Academic year in Israel runs Sep–Aug. For Sep 2025 – Aug 2026 use 2026.
# ---------------------------------------------------------------------------

PORT=3000
ACADEMIC_YEAR=2026

# How long to cache each Mashov response, in seconds.
# Mashov data doesn't change minute-to-minute, and the kids' tablet polls often.
CACHE_TTL_SECONDS=300

# ---------------------------------------------------------------------------
# Kids. One block per child. Add KID_3_* / KID_4_* as needed.
# Each kid is a separate Mashov login (parent or student credentials).
#
# KID_x_ID       — internal slug used in the URL (e.g. "eitan")
# KID_x_NAME     — display name (Hebrew is fine)
# KID_x_COLOR    — accent color for the kid's card (any CSS color)
# KID_x_SEMEL    — school ID
# KID_x_USERNAME — Mashov username or Israeli ID
# KID_x_PASSWORD — Mashov password
# ---------------------------------------------------------------------------

KID_1_ID=eitan
KID_1_NAME=איתן
KID_1_COLOR=#e8513f
KID_1_SEMEL=123456
KID_1_USERNAME=000000000
KID_1_PASSWORD=changeme

KID_2_ID=ori
KID_2_NAME=אורי
KID_2_COLOR=#3a86ff
KID_2_SEMEL=123456
KID_2_USERNAME=000000000
KID_2_PASSWORD=changeme
