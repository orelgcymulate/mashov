{
  "name": "mashov-dashboard",
  "version": "0.2.0",
  "description": "Family home dashboard — NestJS API + Next.js webapp + MongoDB",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "npm run -w @mashov/api start:dev",
    "dev:web": "npm run -w @mashov/web dev",
    "build": "npm run -w @mashov/shared build && npm run -w @mashov/api build && npm run -w @mashov/web build",
    "seed": "npm run -w @mashov/api seed",
    "typecheck": "npm run -ws --if-present typecheck"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "concurrently": "^8.2.2",
    "jest": "^30.4.2",
    "ts-jest": "^29.4.9",
    "typescript": "^5.5.0"
  },
  "overrides": {
    "@nestjs/core": "^10.4.0",
    "@nestjs/common": "^10.4.0"
  }
}
