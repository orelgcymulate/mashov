{
  "name": "mashov-dashboard",
  "version": "0.1.0",
  "description": "Family home dashboard for Mashov (Israeli school system) — TypeScript backend + tablet webapp",
  "private": true,
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch src/server.ts",
    "dev:web": "esbuild web/app.ts --bundle --outfile=public/app.js --watch",
    "build": "esbuild web/app.ts --bundle --outfile=public/app.js --minify",
    "start": "npm run build && tsx src/server.ts",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "mashov-api": "^1.0.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.11.0",
    "concurrently": "^8.2.2",
    "esbuild": "^0.20.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.0"
  }
}
